<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='lar_table_circular'>
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>
    <link name='circular_table'>
      <pose>0 0 0.388 0 -0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>

      <visual name='visual'>
        <pose>0 0 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <transparency>0</transparency>
        <geometry>
          <mesh>
            <uri>model://lar_table_circular/meshes/lar_table_circular.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name='collision_main'>
        <pose>-0 -0 0.009826 0 0 0</pose>
        <max_contacts>10</max_contacts>
        <geometry>
          <box>
            <size>1.2 1.2 0.75</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
